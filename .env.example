# ── Agent brains (required) ─────────────────────────────────────
ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=claude-opus-4-8
SPECIALIST_MODEL=claude-haiku-4-5
JUDGE_MODEL=claude-sonnet-5

# ── Voice (optional — "none" = text-only mode) ──────────────────
VOICE_STT=none                 # deepgram | whisper | none
VOICE_TTS=none                 # openai | elevenlabs | none
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts   # if VOICE_TTS=openai
OPENAI_TTS_VOICE=alloy
ELEVENLABS_VOICE_ID=               # if VOICE_TTS=elevenlabs

# ── Data providers ──────────────────────────────────────────────
TRAVEL_PROVIDER=mock           # mock | amadeus
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ── MCP servers ─────────────────────────────────────────────────
MCP_TRAVEL_URL=http://localhost:8101/mcp
MCP_WEATHER_URL=http://localhost:8102/mcp
MCP_AGENCY_URL=http://localhost:8103/mcp

# ── State (empty = in-memory / sqlite) ──────────────────────────
REDIS_URL=
DATABASE_URL=

# ── Observability (optional locally) ────────────────────────────
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Orchestrator service ────────────────────────────────────────
PORT=8080
