# Copy to .env at repository root. scripts/dev.sh loads it; individual pnpm
# commands do not. Never commit populated keys. Values below are implemented.

# Required for live text planning
ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=claude-opus-4-8
SPECIALIST_MODEL=claude-haiku-4-5

# Optional voice. Providers are selected explicitly, not automatic failover.
VOICE_STT=none                  # deepgram | whisper | none
VOICE_TTS=none                  # openai | elevenlabs | none
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Travel inventory is always mock. No Amadeus integration exists.
AIRBNB_SEARCH_MODE=links        # links | live (independent connector; may be blocked)
WEATHER_PROVIDER=live           # live (Open-Meteo) | mock (deterministic climate)

# Internal MCP endpoints; keep private in a hosted environment.
MCP_TRAVEL_URL=http://localhost:8101/mcp
MCP_WEATHER_URL=http://localhost:8102/mcp
MCP_AGENCY_URL=http://localhost:8103/mcp

# Server bind address and exact allowed frontend origin.
# scripts/dev.sh assigns each service's PORT explicitly.
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000

# Public browser API base. Used for HTTP and derived ws/wss URLs.
# For deployment, set before building Next.js; localhost is local testing only.
NEXT_PUBLIC_ORCH_URL=http://localhost:8080

# Optional durable mode. Compose sets this automatically; empty uses local memory.
DATABASE_URL=
# Direct development only. Production requires proxy auth and a secret gateway token.
AUTH_MODE=none
GATEWAY_TOKEN=
# Redis, Langfuse and eval judges are NOT implemented.
