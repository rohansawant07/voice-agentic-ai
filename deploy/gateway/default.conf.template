map $http_upgrade $connection_upgrade { default upgrade; '' close; }
limit_req_zone $binary_remote_addr zone=chat:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=socket:10m rate=12r/m;
limit_conn_zone $binary_remote_addr zone=connections:10m;
server {
  listen 8080;
  server_tokens off;
  resolver 127.0.0.11 valid=5s ipv6=off;
  # Behind the AWS Caddy proxy, rate limits key on the real client address.
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 192.168.0.0/16;
  real_ip_header X-Forwarded-For;
  set $web_upstream web:3000;
  set $api_upstream orchestrator:8080;
  client_max_body_size 32k;
  auth_basic "Roam private preview";
  auth_basic_user_file /run/secrets/htpasswd;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  add_header X-Frame-Options DENY always;
  limit_req_status 429;
  limit_conn_status 429;
  location = /healthz { auth_basic off; access_log off; return 200 'ok'; }
  location / {
    proxy_pass http://$web_upstream;
    proxy_set_header Host $host;
    proxy_set_header Authorization "";
  }
  location = /api/chat {
    limit_req zone=chat burst=2 nodelay;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Roam-Gateway "${GATEWAY_TOKEN}";
    proxy_set_header X-Roam-User $remote_user;
    proxy_set_header X-Roam-Owner "";
    proxy_set_header Authorization "";
    proxy_read_timeout 180s;
  }
  location ~ ^/(ws|voice)$ {
    limit_req zone=socket burst=4 nodelay;
    limit_conn connections 8;
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Roam-Gateway "${GATEWAY_TOKEN}";
    proxy_set_header X-Roam-User $remote_user;
    proxy_set_header X-Roam-Owner "";
    proxy_set_header Authorization "";
    proxy_read_timeout 3600s;
    proxy_buffering off;
  }
}
